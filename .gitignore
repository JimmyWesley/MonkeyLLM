.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
test-results/
.env

# Generated forests never enter the outer repo — rebuild them via
# forests/scripts/ (each forest has its OWN embedded git)
forests/*
!forests/scripts/

# Local inference artifacts (downloaded by scripts/setup_models.py, which
# writes to ROOT/models and ROOT/bin). Anchored to the repository root on
# purpose: unanchored, `models/` also matched
# `apps/studio/src/locales/models/`, so the Models console's 38 translations
# lived on every developer's disk and in no clone — the suite read the
# working tree and passed while a fresh checkout rendered raw keys.
/models/
/bin/
*.gguf
bench/_artifacts/
ideias/

# Logo generation scripts
scripts/remove_bg.py
scripts/make_dark_logo.py
scripts/make_rounded_icon.py
scripts/gen_icons.py

# Agent session state. Untracked but unignored is not the same as ignored: the
# directory holds worktrees (each a full second copy of the repo, paper
# included) and session transcripts, so one distracted `git add .` publishes
# them. Anchored to the repository root — a worktree's own .claude is the
# same directory seen from inside.
/.claude/

# macOS Finder
.DS_Store
