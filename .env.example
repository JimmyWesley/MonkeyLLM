# MonkeyLLM environment — copy to .env and fill in.
#
# The root docker-compose.yml reads this file natively (compose loads .env
# for ${...} interpolation): anything left commented out falls back to the
# code's own default. Outside Docker the code reads plain environment
# variables (no python-dotenv) — load this file yourself, e.g.:
#   zsh/bash : set -a; source .env; set +a
#   PowerShell: gc .env | ? {$_ -match '^\s*[^#]'} | % { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k,$v) }

# ── Chat LLM (curator, demo agent, bench, measurement scripts) ──────────
# Any OpenAI-compatible /v1 endpoint.
#
# The Station also reads these: an endpoint set here arrives in the Models
# console as a ready provider, keyed, marked "from the environment" (spec
# J.10.1). The key stays here — it is never written to the registry — so it
# is rotated by editing this file and restarting, and a console operator is
# never asked to paste it. Such a provider is read-only in the console.

# Option A — OpenRouter (no local GPU needed):
MONKEYLLM_LLM_ENDPOINT=https://openrouter.ai/api/v1
MONKEYLLM_LLM_API_KEY=sk-or-your-key-here
# What to call it in the console. Optional — the host name is used when
# unset (`openrouter.ai`, `localhost:8090`):
#MONKEYLLM_LLM_PROVIDER=openrouter
# Always set the model explicitly with OpenRouter — the "local" fallback
# would pick the first entry of OpenRouter's huge /models list.
MONKEYLLM_LLM_MODEL=google/gemma-3-12b-it

# Option B — local llama.cpp (scripts/serve_llm.py on the CUDA box):
#MONKEYLLM_LLM_ENDPOINT=http://localhost:8090/v1
#MONKEYLLM_LLM_API_KEY=no-key
#MONKEYLLM_LLM_MODEL=local        # auto-detected from the server's /models

# Option C — llama.cpp INSIDE the root docker compose (no external
# provider): `docker compose --profile local-llm up -d`, then point at the
# service by its compose DNS name:
#MONKEYLLM_LLM_ENDPOINT=http://llm:8090/v1
#MONKEYLLM_LLM_API_KEY=no-key
#MONKEYLLM_LLM_MODEL=local

# Completion budget (curator default 300, demo default 600):
#MONKEYLLM_LLM_MAX_TOKENS=600
# Set to "on" to request reasoning tokens (OpenRouter-normalized field;
# when on, +1000 is added to max_tokens to make room for the thinking):
#MONKEYLLM_LLM_REASONING=off

# ── Embedder (optional Canopy vector layer + bench RAG baselines) ───────
# OpenRouter does NOT serve /v1/embeddings — use a local llama.cpp
# embedding server or another OpenAI-compatible provider. Leave unset to
# keep `locate` on its BM25-only Phase 0 contract.
#MONKEYLLM_EMBED_ENDPOINT=http://localhost:8091/v1
#MONKEYLLM_EMBED_MODEL=bge-m3
#MONKEYLLM_EMBED_API_KEY=no-key
#MONKEYLLM_EMBED_PROVIDER=ollama
# Same endpoint and key as the chat one above ⇒ one provider in the console,
# not two. Different ports or different keys ⇒ two, deliberately.

# ── Station (apps/station — the deployable host, spec Part J) ───────────
# Break-glass super-admin (J.2.1). LEAVE THESE COMMENTED unless you know you
# want them: a Station with no credential shows the first-run setup screen
# (J.2.4), where you create the owner in the browser. Setting these two
# REPLACES that screen — the deployment has then declared its first identity
# in the environment, and offering both doors would let them race for it.
#
# Reach for them when you want a credential that lives in the environment and
# rotates by restarting, or to get back in after losing the owner's password.
# Compared against the environment at login and NEVER stored.
#MONKEYLLM_STATION_ADMIN=jimmy
#MONKEYLLM_STATION_PASSWORD=something long and unguessable
# First key instead of the first screen (J.2.5), for a deployment with no
# browser: on a Station nobody owns yet, the boot mints ONE full-authority
# API key and prints it in the log. It is shown once, and it closes the
# setup screen — the screen and the key are the same one-shot window.
# Off by default; a restart on a Station that already has a way in mints
# nothing, whatever this says.
#MONKEYLLM_STATION_BOOTSTRAP_KEY=1
# Hosts the MCP surface (/mcp) answers to. Add your public host:port when
# the Station sits behind a reverse proxy or a Dokploy domain; `*` disables
# the host check (every request still needs an API key). REST and Studio
# are unaffected.
#MONKEYLLM_STATION_ALLOWED_HOSTS=localhost,localhost:8800,127.0.0.1,127.0.0.1:8800
# Where the Station looks inside its container — already set by the image,
# only override for a non-Docker install:
#MONKEYLLM_STATION_ROOT=/forests
#MONKEYLLM_STATION_REGISTRY=/registry/station.db

# ── docker-compose.yml knobs (compose interpolation, not app env) ───────
# Host port the Station is published on, and the address it binds to. The
# default is loopback: on a laptop that is what you want, and on a server a
# reverse proxy reaches the container over the docker network rather than
# the host port. Set 0.0.0.0 only to expose it on the LAN yourself.
#STATION_PORT=8800
#STATION_BIND=127.0.0.1
# The network everything joins. On a managed host (Dokploy, Coolify) name
# the proxy network it already created and mark it external — that is the
# whole difference between this file on a laptop and the same file in
# production, which is why there is no second compose file:
#STATION_NETWORK=dokploy-network
#STATION_NETWORK_EXTERNAL=true
# Compose starts the profiled sidecars below only when this is set (there
# is no --profile flag to pass in a platform's UI):
#COMPOSE_PROFILES=local-embed
# Optional local inference profiles (`--profile local-llm/local-embed`):
# Hugging Face repo:quant each llama.cpp service downloads on first start
# (into the persistent `models` volume), and the chat context size.
#LLAMA_CHAT_HF=bartowski/Qwen2.5-7B-Instruct-GGUF:Q4_K_M
#LLAMA_EMBED_HF=gpustack/bge-m3-GGUF:Q8_0
#LLAMA_CTX=8192
#LLM_PORT=8090
#EMBED_PORT=8091

# ── Misc ────────────────────────────────────────────────────────────────
# Default forest path for the MCP server (`vine serve` without --forest):
#MONKEYLLM_FOREST=forests/forest-fixture
# S3-compatible endpoint for remote payloads (MinIO/R2, spec G.9):
#MONKEYLLM_S3_ENDPOINT=
# Directories the Station may mirror on a caller's behalf (J.8.2), OS path
# separator between them. Leave it unset and the Station reads no host path
# at all — sending documents through the console still works, "mirror a
# host folder" is simply off. This is the safe default on purpose: the
# deployment that most needs the boundary is the one nobody configured.
# Naming the forest registry (/forests) is refused and logged at boot.
#MONKEYLLM_INGEST_ROOTS=/data
