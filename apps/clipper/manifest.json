{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.51.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "notifications",
    "offscreen"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "__MSG_cmdOpen__"
    },
    "clip-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdClipPage__"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_cmdRegion__"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
